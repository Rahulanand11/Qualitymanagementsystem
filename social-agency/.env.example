# ---- Core ----
APP_ENV=development                 # development | production
DATA_DIR=./data                     # database, derivatives, previews, reports
# WATCH_ROOT=./data/Social Media    # the synced folder (Google Drive / Dropbox / OneDrive desktop sync folder)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/agency   # default: SQLite in DATA_DIR
SECRET_KEY=                         # session signing key (required in production)
TOKEN_ENCRYPTION_KEY=               # Fernet key for OAuth tokens (required in production)
PUBLIC_BASE_URL=http://localhost:8000   # must be public HTTPS for Instagram publishing + OAuth

# ---- Meta / Instagram (Instagram API with Instagram Login) ----
META_APP_ID=
META_APP_SECRET=
IG_API_VERSION=v23.0
IG_SEND_ALT_TEXT=true

# ---- Claude (AI analysis, captions, planning) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# AI_MODEL_LIGHT=claude-opus-5-5    # model for light tasks (comment classification); set a cheaper model to cut costs
AI_MONTHLY_BUDGET_USD=50

# ---- Worker ----
WORKER_INTERVAL_SECONDS=15
UPLOAD_STABLE_SECONDS=10            # a file must be unchanged this long before it is processed
